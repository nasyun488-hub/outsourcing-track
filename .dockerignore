# ==========================================
# 通用排除项
# ==========================================
.git
.gitignore
.github
.vscode
.idea
*.md
*.txt
LICENSE
*.log
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# ==========================================
# 文档与临时文件
# ==========================================
docs/
*.zip
*.docx
*.tmp
*.temp
.DS_Store
Thumbs.db

# ==========================================
# 环境变量
# ==========================================
.env
.env.*
docker-compose.override.yml

# ==========================================
# 前后端互不包含
# ==========================================
# 前端镜像不需要后端源码
backend/
*.sql

# 后端镜像不需要前端构建产物
frontend/node_modules/
frontend/dist/